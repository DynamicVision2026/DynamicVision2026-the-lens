{
  "name": "the-lens",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "bundle": "bash -O globstar -c 'python3 tools/validate.py cards/**/*.yaml --bundle'",
    "dev:trainer": "pnpm --filter @lens/trainer dev",
    "dev:shorts": "pnpm --filter @lens/shorts dev",
    "typecheck": "node scripts/check-bundle.mjs && pnpm -r typecheck",
    "build": "pnpm --filter @lens/trainer build",
    "test": "pnpm -r test",
    "check:literals": "node scripts/check-no-literals.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
